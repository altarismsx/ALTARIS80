# AHORCADO - adivina la palabra letra por letra
REM AHORCADO - (C) 2026 Altaris Software
ON ERROR GOTO {error}
MODE 0:VDU 23,1,0;0;0;0;
RESTORE {palabras}
NP%=0
REPEAT READ C$,P$:NP%=NP%+1:UNTIL P$="FIN"
NP%=NP%-1
GA%=0:PE%=0
{juego} PROCnueva
REPEAT
PROCestado
REPEAT L$=FNletra:UNTIL L$<>""
IF INSTR(US$,L$)>0 THEN PROCmsg("Esa letra ya la dijiste") ELSE PROCprueba(L$)
UNTIL ER%>=7 OR FNcompleta
PROCestado
IF ER%>=7 THEN PE%=PE%+1:PROCmsg("¡Perdiste! Era "+P$) ELSE GA%=GA%+1:PROCmsg("¡Muy bien! Adivinaste la palabra")
PROCmarcador
IF FNotra THEN GOTO {juego}
CHAIN "MENU"
#
DEF PROCnueva
LOCAL N%,I%
N%=RND(NP%)
RESTORE {palabras}
FOR I%=1 TO N%:READ C$,P$:NEXT
US$="":ER%=0
CLS:CLG
PRINT TAB(28,0);"A H O R C A D O"
PRINT TAB(28,2);"Categoría: ";C$
PRINT TAB(28,3);"(la Ñ es Fn + N)";
PRINT TAB(28,10);"Letras usadas:"
PRINT TAB(51,15);"Volver: salir";
GCOL 0,1
MOVE 10,8:DRAW 90,8:MOVE 30,8:DRAW 30,120:DRAW 80,120:DRAW 80,104
MOVE 30,104:DRAW 46,120
PROCmarcador
ENDPROC
#
DEF PROCmarcador
PRINT TAB(28,15);"Ganadas ";GA%;"  Perdidas ";PE%;
ENDPROC
#
DEF PROCestado
LOCAL I%,W$,C$
W$=""
FOR I%=1 TO LEN(P$)
C$=MID$(P$,I%,1)
IF C$=" " OR INSTR(US$,C$)>0 OR ER%>=7 THEN W$=W$+C$+" " ELSE W$=W$+"_ "
NEXT
PRINT TAB(28,5);SPC(36);
PRINT TAB(28,5);W$;
PRINT TAB(28,11);US$;
PRINT TAB(28,7);"Errores: ";ER%;" de 7  ";
ENDPROC
#
DEF PROCmsg(T$)
PRINT TAB(28,13);SPC(36);
PRINT TAB(28,13);T$;
ENDPROC
#
DEF FNletra
LOCAL K%,A%
K%=GET
IF K%>=97 AND K%<=122 THEN K%=K%-32
IF K%=241 THEN K%=209
A%=INSTR(CHR$225+CHR$233+CHR$237+CHR$243+CHR$250+CHR$193+CHR$201+CHR$205+CHR$211+CHR$218,CHR$K%)
IF A%>0 THEN K%=ASC(MID$("AEIOUAEIOU",A%,1))
IF (K%>=65 AND K%<=90) OR K%=209 THEN PROCmsg(""):=CHR$K%
=""
#
DEF PROCprueba(L$)
US$=US$+L$
IF INSTR(P$,L$)>0 THEN SOUND 1,-15,150,2:ENDPROC
ER%=ER%+1:PROCparte(ER%)
ENDPROC
#
DEF FNcompleta
LOCAL I%,C$,OK%
OK%=TRUE
FOR I%=1 TO LEN(P$)
C$=MID$(P$,I%,1)
IF C$<>" " AND INSTR(US$,C$)=0 THEN OK%=FALSE
NEXT
=OK%
#
REM Dibuja una parte del ahorcado
DEF PROCparte(N%)
GCOL 0,1
IF N%=1 THEN CIRCLE 80,96,8
IF N%=2 THEN MOVE 80,88:DRAW 80,60
IF N%=3 THEN MOVE 80,84:DRAW 68,70
IF N%=4 THEN MOVE 80,84:DRAW 92,70
IF N%=5 THEN MOVE 80,60:DRAW 70,40
IF N%=6 THEN MOVE 80,60:DRAW 90,40
IF N%=7 THEN PROCcara
ENDPROC
#
DEF PROCcara
GCOL 0,1
MOVE 76,98:DRAW 78,96:MOVE 78,98:DRAW 76,96
MOVE 82,98:DRAW 84,96:MOVE 84,98:DRAW 82,96
MOVE 77,92:DRAW 83,92
ENDPROC
#
DEF FNotra
LOCAL K$
PRINT TAB(28,14);"¿Otra palabra? (S/N)";
REPEAT K$=GET$:UNTIL INSTR("SsNn",K$)
=(K$="S" OR K$="s")
#
{error} IF ERR=17 THEN CHAIN "MENU"
MODE 0:VDU 23,1,1;0;0;0;:REPORT:PRINT " (línea ";ERL;")":END
