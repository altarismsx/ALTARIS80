# VIBORITA - la clasica viborita que come y crece
REM VIBORITA - (C) 2026 Altaris Software
ON ERROR GOTO {error}
MODE 1:VDU 23,1,0;0;0;0;
DIM SX%(600),SY%(600),G%(39,15),DXX%(3),DYY%(3)
VDU 23,162,60,126,255,255,255,255,126,60
VDU 23,163,60,126,219,255,255,231,126,60
VDU 23,164,24,60,126,255,255,126,60,24
VDU 23,165,255,129,189,165,165,189,129,255
DXX%(0)=1:DYY%(0)=0:DXX%(1)=0:DYY%(1)=-1:DXX%(2)=-1:DYY%(2)=0:DXX%(3)=0:DYY%(3)=1
REC%=FNleerec
{inicio} PROCportada
{juego} PROCarmar
REPEAT
T%=TIME
PROCteclas
NX%=SX%(CA%)+DXX%(DI%):NY%=SY%(CA%)+DYY%(DI%)
IF G%(NX%,NY%)<>0 AND G%(NX%,NY%)<>3 THEN MUERTO%=TRUE ELSE PROCavanza
IF DEMO% THEN IF INKEY(0)>=0 OR TIME>TD% THEN MUERTO%=TRUE
REPEAT UNTIL TIME>=T%+VE%
UNTIL MUERTO%
IF DEMO% THEN GOTO {inicio}
PROCchoque
PROCfin
IF FNotra THEN GOTO {juego}
CHAIN "MENU"
#
DEF PROCportada
LOCAL I%,K%
CLS
PRINT TAB(13,2);"V I B O R I T A"
PRINT TAB(11,4);"Altaris Software ";CHR$169;" 2026"
FOR I%=8 TO 28:VDU 31,I%,6,162:NEXT:VDU 31,29,6,163,31,32,6,164
PRINT TAB(4,9);"Comé las frutas para crecer."
PRINT TAB(4,10);"No choques con las paredes ni"
PRINT TAB(4,11);"con tu propia cola."
PRINT TAB(4,12);"Flechas: cambiar de dirección"
PRINT TAB(4,13);"Récord: ";REC%
PRINT TAB(4,15);"Pulse Espacio para empezar";
K%=INKEY(1000):DEMO%=(K%<>32)
ENDPROC
#
DEF PROCarmar
LOCAL X%,Y%,I%
CLS
FOR X%=0 TO 39:FOR Y%=1 TO 15:G%(X%,Y%)=0:NEXT:NEXT
FOR X%=0 TO 39:G%(X%,1)=1:G%(X%,15)=1:VDU 31,X%,1,165,31,X%,15,165:NEXT
FOR Y%=2 TO 14:G%(0,Y%)=1:G%(39,Y%)=1:VDU 31,0,Y%,165,31,39,Y%,165:NEXT
PRINT TAB(0,0);"VIBORITA";
IF DEMO% THEN PRINT TAB(16,0);"DEMO";
LA%=4:CO%=0:CA%=LA%-1
FOR I%=0 TO LA%-1:SX%(I%)=8+I%:SY%(I%)=8:G%(8+I%,8)=2:VDU 31,8+I%,8,162:NEXT
VDU 31,SX%(CA%),8,163
DI%=0:CRECE%=0:PU%=0:VE%=12:MUERTO%=FALSE:TD%=TIME+6000
PROCfruta
PROCmarcador
ENDPROC
#
DEF PROCmarcador
PRINT TAB(22,0);"PUNTOS ";PU%;"  R ";REC%;"  ";
ENDPROC
#
DEF PROCfruta
LOCAL X%,Y%
REPEAT X%=1+RND(38):Y%=2+RND(13):UNTIL G%(X%,Y%)=0
G%(X%,Y%)=3:FX%=X%:FY%=Y%:VDU 31,X%,Y%,164
ENDPROC
#
DEF PROCteclas
IF DEMO% THEN PROCpiloto:ENDPROC
IF INKEY(-122) AND DI%<>2 THEN DI%=0
IF INKEY(-58) AND DI%<>3 THEN DI%=1
IF INKEY(-26) AND DI%<>0 THEN DI%=2
IF INKEY(-42) AND DI%<>1 THEN DI%=3
ENDPROC
#
REM Piloto automatico: va hacia la fruta sin chocar
DEF PROCpiloto
LOCAL D%,B%,M%,X%,Y%,S%
B%=DI%:M%=9999
FOR D%=0 TO 3
IF (D%+2) MOD 4<>DI% THEN X%=SX%(CA%)+DXX%(D%):Y%=SY%(CA%)+DYY%(D%):IF G%(X%,Y%)=0 OR G%(X%,Y%)=3 THEN S%=ABS(X%-FX%)+ABS(Y%-FY%)+RND(2):IF S%<M% THEN M%=S%:B%=D%
NEXT
DI%=B%
ENDPROC
#
DEF PROCavanza
LOCAL C%
C%=(CA%+1) MOD 600
VDU 31,SX%(CA%),SY%(CA%),162
IF G%(NX%,NY%)=3 THEN PU%=PU%+10:CRECE%=CRECE%+3:SOUND 1,-15,150,1:IF VE%>4 THEN VE%=VE%-1
SX%(C%)=NX%:SY%(C%)=NY%:CA%=C%
IF G%(NX%,NY%)=3 THEN G%(NX%,NY%)=2:PROCfruta:PROCmarcador ELSE G%(NX%,NY%)=2
VDU 31,NX%,NY%,163
IF CRECE%>0 THEN CRECE%=CRECE%-1:LA%=LA%+1:ENDPROC
C%=(CA%-LA%+600) MOD 600
G%(SX%(C%),SY%(C%))=0:VDU 31,SX%(C%),SY%(C%),32
ENDPROC
#
DEF PROCchoque
LOCAL I%
SOUND 1,-15,20,20
FOR I%=1 TO 6:VDU 31,SX%(CA%),SY%(CA%),165:WAIT 8:VDU 31,SX%(CA%),SY%(CA%),163:WAIT 8:NEXT
ENDPROC
#
DEF PROCmsg(T$)
PRINT TAB(20-LEN(T$) DIV 2,0);T$;
ENDPROC
#
DEF PROCfin
PRINT TAB(0,0);SPC(40);
PROCmsg("FIN DEL JUEGO - "+STR$(PU%)+" PUNTOS")
IF PU%>REC% THEN REC%=PU%:PROCgrabarec:WAIT 100:PRINT TAB(0,0);SPC(40);:PROCmsg("¡Nuevo récord! "+STR$(PU%))
WAIT 150
ENDPROC
#
DEF FNotra
LOCAL K$
PRINT TAB(0,0);SPC(40);
PROCmsg("¿Otra partida? (S/N)")
REPEAT K$=GET$:UNTIL INSTR("SsNn",K$)
=(K$="S" OR K$="s")
#
DEF FNleerec
LOCAL F%,R%
F%=OPENIN "VIBORITA.REC"
IF F%=0 THEN =0
INPUT#F%,R%:CLOSE#F%
=R%
#
DEF PROCgrabarec
LOCAL F%
F%=OPENOUT "VIBORITA.REC":PRINT#F%,REC%:CLOSE#F%
ENDPROC
#
{error} IF ERR=17 THEN CHAIN "MENU"
MODE 0:VDU 23,1,1;0;0;0;:REPORT:PRINT " (línea ";ERL;")":END
