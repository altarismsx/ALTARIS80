# CHE FENIX - defende la Tierra de los pajaros invasores
# Version para ALTARIS 80 del juego de Altaris Software.
REM CHE FENIX - (C) 2026 Altaris Software
ON ERROR GOTO {error}
MODE 1:VDU 23,1,0;0;0;0;
DIM FG%(29,2),DX%(2),DY%(2),DC%(2),DR%(2),BBX%(2),BBY%(2),G% 10
PROCcaracteres
REC%=FNleerec
{inicio} PROCportada
{juego} VI%=3:PU%=0:WAV%=0:FUERA%=FALSE:TD%=TIME+6000
REPEAT
WAV%=WAV%+1
PROConda
REPEAT
TF%=TIME
PROCjugador
PROCbala
IF FR% MOD VA%=0 THEN PROCvaiven
PROCbuzos
PROCbombas
PROCnave
FR%=FR%+1
IF DEMO% THEN IF INKEY(0)>=0 OR TIME>TD% THEN FUERA%=TRUE
REPEAT UNTIL TIME>=TF%+5
UNTIL QU%=0 OR VI%=0 OR FUERA%
IF QU%=0 AND NOT FUERA% THEN PROCmsg("ONDA "+STR$(WAV%)+" SUPERADA"):WAIT 150:PROCmsg("")
UNTIL VI%=0 OR FUERA%
IF DEMO% THEN GOTO {inicio}
PROCfin
IF FNotra THEN GOTO {juego}
CHAIN "MENU"
#
DEF PROCcaracteres
VDU 23,162,24,24,60,126,255,219,153,0
VDU 23,163,129,195,102,60,24,36,0,0
VDU 23,164,0,24,60,126,219,153,36,0
VDU 23,165,24,24,24,24,24,24,0,0
VDU 23,166,0,0,24,60,24,0,0,0
VDU 23,167,165,90,36,195,195,36,90,165
ENDPROC
#
DEF PROCportada
LOCAL K%,I%
VDU 26:CLS:CLG
FOR I%=1 TO 30:PLOT 69,RND(319),RND(127):NEXT
PROCgrande("CHE",133,124,3)
PROCgrande("F"+CHR$201+"NIX",115,96,3)
PRINT TAB(11,7);"Altaris Software ";CHR$169;" 2026"
PRINT TAB(4,9);"Flechas o Z/X: mover"
PRINT TAB(4,10);"Espacio: disparar"
PRINT TAB(4,11);"Flecha abajo: escudo"
PRINT TAB(4,13);"R";CHR$233;"cord: ";REC%
PRINT TAB(4,15);"Pulse Espacio para empezar";
K%=INKEY(1000):DEMO%=(K%<>32)
ENDPROC
#
DEF PROCgrande(T$,X0%,Y0%,S%)
LOCAL I%,F%,B%
FOR I%=1 TO LEN(T$)
?G%=ASC(MID$(T$,I%,1)):A%=10:X%=G% MOD 256:Y%=G% DIV 256:CALL &FFF1
FOR F%=0 TO 7
B%=G%?(F%+1)
IF B% THEN PROCfila(B%,X0%+(I%-1)*6*S%,Y0%-F%*S%,S%)
NEXT
NEXT
ENDPROC
#
DEF PROCfila(B%,X1%,Y1%,S%)
LOCAL C%
FOR C%=0 TO 7
IF B% AND 2^(7-C%) THEN RECTANGLE FILL X1%+C%*S%,Y1%,S%-1,S%-1
NEXT
ENDPROC
#
REM Arma una onda: 3 filas de 7 pajaros
DEF PROConda
LOCAL C%,R%
VDU 26:CLS
FOR C%=1 TO 20:PLOT 69,RND(236),20+RND(70):NEXT
FOR C%=0 TO 15:VDU 31,30,C%,137:NEXT
PRINT TAB(32,0);"CHE";
PRINT TAB(32,1);"FENIX";
PRINT TAB(32,3);"PUNTOS";
PRINT TAB(32,6);"VIDAS";
PRINT TAB(32,9);"ONDA";
PRINT TAB(32,12);"RECORD";
IF DEMO% THEN PRINT TAB(32,15);"DEMO";
FOR C%=0 TO 29:FOR R%=0 TO 2:FG%(C%,R%)=0:NEXT:NEXT
QU%=0
FOR C%=2 TO 20 STEP 3:FOR R%=0 TO 2:FG%(C%,R%)=1:QU%=QU%+1:NEXT:NEXT
DES%=3:DIR%=1:FR%=0:VA%=6
FOR R%=0 TO 2:PROCfilaform(R%):NEXT
PX%=14:BALY%=-1:ESC%=0:CARGA%=0
FOR C%=0 TO 2:DY%(C%)=-1:BBY%(C%)=-1:NEXT
VDU 31,PX%,15,162
PROCmarcador
ENDPROC
#
DEF PROCfilaform(R%)
LOCAL C%,L$
L$=""
FOR C%=0 TO 29-DES%
IF FG%(C%,R%) THEN L$=L$+CHR$(163+(R% MOD 2)) ELSE L$=L$+" "
NEXT
PRINT TAB(DES%,3+R%*2);L$;
ENDPROC
#
DEF PROCnave
IF ESC%>0 THEN COLOUR 129:COLOUR 0
VDU 31,PX%,15,162
COLOUR 128:COLOUR 1
ENDPROC
#
DEF PROCmarcador
PRINT TAB(32,4);PU%;"  ";
PRINT TAB(32,7);VI%;"  ";
PRINT TAB(32,10);WAV%;"  ";
PRINT TAB(32,13);REC%;"  ";
ENDPROC
#
DEF PROCmsg(T$)
PRINT TAB(1,11);SPC(28);
IF T$<>"" THEN PRINT TAB(15-LEN(T$) DIV 2,11);T$;
ENDPROC
#
REM Movimiento del jugador, disparo y escudo
DEF PROCjugador
LOCAL N%,F%
N%=PX%:F%=FALSE
IF DEMO% THEN PROCauto ELSE IF INKEY(-26) OR INKEY(-98) THEN N%=N%-1
IF NOT DEMO% THEN IF INKEY(-122) OR INKEY(-67) THEN N%=N%+1
IF NOT DEMO% THEN F%=INKEY(-99)
IF N%<0 THEN N%=0
IF N%>29 THEN N%=29
IF N%<>PX% THEN VDU 31,PX%,15,32:PX%=N%:VDU 31,PX%,15,162
IF F% AND BALY%<0 THEN BALX%=PX%:BALY%=14:VDU 31,BALX%,BALY%,165
IF ESC%>0 THEN ESC%=ESC%-1:IF ESC%=0 THEN VDU 31,PX%,15,162
IF CARGA%>0 THEN CARGA%=CARGA%-1
IF NOT DEMO% THEN IF INKEY(-42) AND ESC%=0 AND CARGA%=0 THEN ESC%=12:CARGA%=80:COLOUR 129:COLOUR 0:VDU 31,PX%,15,162:COLOUR 128:COLOUR 1
ENDPROC
#
REM Modo demostracion: sigue a un pajaro y dispara
DEF PROCauto
LOCAL T%
T%=PX%
IF RND(4)=1 THEN T%=DES%+2+3*RND(6)
IF T%<PX% THEN N%=PX%-1
IF T%>PX% THEN N%=PX%+1
F%=(RND(3)=1)
ENDPROC
#
REM Bala del jugador: sube una fila por cuadro
DEF PROCbala
LOCAL R%,C%,K%
IF BALY%<0 THEN ENDPROC
VDU 31,BALX%,BALY%,32
BALY%=BALY%-1
IF BALY%<1 THEN BALY%=-1:ENDPROC
R%=BALY%-3
IF R%>=0 AND R%<=4 AND R% MOD 2=0 THEN C%=BALX%-DES%:IF C%>=0 AND C%<=29 THEN IF FG%(C%,R% DIV 2) THEN PROCderribo(C%,R% DIV 2):ENDPROC
FOR K%=0 TO 2
IF DY%(K%)>=0 THEN IF DX%(K%)=BALX% AND (DY%(K%)=BALY% OR DY%(K%)=BALY%+1) THEN PROCcaebuzo(K%):BALY%=-1
NEXT
IF BALY%>=0 THEN VDU 31,BALX%,BALY%,165
ENDPROC
#
DEF PROCderribo(C%,R%)
FG%(C%,R%)=0:QU%=QU%-1:PU%=PU%+10*(3-R%)
VDU 31,C%+DES%,3+R%*2,167
SOUND 1,-15,100,1
VDU 31,C%+DES%,3+R%*2,32
BALY%=-1
PROCmarcador
ENDPROC
#
REM Vaiven de la formacion: corre la ventana de las filas 3 a 7
DEF PROCvaiven
LOCAL K%
IF DES%+DIR%<0 OR DES%+DIR%>7 THEN DIR%=-DIR%
DES%=DES%+DIR%
VDU 28,0,7,29,3
IF DIR%>0 THEN VDU 23,7,0,0,0;0;0; ELSE VDU 23,7,0,1,0;0;0;
VDU 26
IF BALY%>=3 AND BALY%<=7 THEN BALX%=BALX%+DIR%
FOR K%=0 TO 2
IF DY%(K%)>=3 AND DY%(K%)<=7 THEN DX%(K%)=DX%(K%)+DIR%
IF BBY%(K%)>=3 AND BBY%(K%)<=7 THEN BBX%(K%)=BBX%(K%)+DIR%
NEXT
ENDPROC
#
REM Pajaros que se tiran en picada (hasta 3)
DEF PROCbuzos
LOCAL K%,C%,R%
FOR K%=0 TO 2
IF DY%(K%)<0 THEN IF RND(FNmax(90-WAV%*8,20))=1 THEN PROCsale(K%)
IF DY%(K%)>=0 THEN PROCvuela(K%)
NEXT
ENDPROC
#
DEF PROCsale(K%)
LOCAL C%,R%,I%
C%=2+3*RND(7)-3
FOR R%=2 TO 0 STEP -1
IF FG%(C%,R%) THEN FG%(C%,R%)=0:QU%=QU%-1:DC%(K%)=C%:DR%(K%)=R%:DX%(K%)=C%+DES%:DY%(K%)=3+R%*2:R%=-1
NEXT
ENDPROC
#
DEF PROCvuela(K%)
IF FR% MOD 2=0 THEN ENDPROC
VDU 31,DX%(K%),DY%(K%),32
DY%(K%)=DY%(K%)+1
IF DX%(K%)<PX% AND RND(2)=1 THEN DX%(K%)=DX%(K%)+1
IF DX%(K%)>PX% AND RND(2)=1 THEN DX%(K%)=DX%(K%)-1
IF DY%(K%)>15 THEN PROCvuelve(K%):ENDPROC
IF DY%(K%)=15 AND DX%(K%)=PX% THEN PROCchoque:PROCcaebuzo(K%):ENDPROC
IF RND(12)=1 THEN PROCtirabomba(DX%(K%),DY%(K%)+1)
VDU 31,DX%(K%),DY%(K%),163+(FR% DIV 2) MOD 2
ENDPROC
#
REM Al salir por abajo vuelve a su lugar en la formacion
DEF PROCvuelve(K%)
LOCAL X%,Y%
X%=DC%(K%)+DES%:Y%=3+DR%(K%)*2
DY%(K%)=-1
FG%(DC%(K%),DR%(K%))=1:QU%=QU%+1
VDU 31,X%,Y%,163+(DR%(K%) MOD 2)
ENDPROC
#
DEF PROCcaebuzo(K%)
VDU 31,DX%(K%),DY%(K%),167
SOUND 1,-15,100,1
VDU 31,DX%(K%),DY%(K%),32
DY%(K%)=-1:PU%=PU%+50:PROCmarcador
ENDPROC
#
DEF PROCtirabomba(X%,Y%)
LOCAL K%
FOR K%=0 TO 2
IF BBY%(K%)<0 THEN BBX%(K%)=X%:BBY%(K%)=Y%:K%=3
NEXT
ENDPROC
#
DEF PROCbombas
LOCAL K%
FOR K%=0 TO 2
IF BBY%(K%)>=0 THEN PROCbomba(K%)
NEXT
IF FR% MOD 7=0 AND QU%>0 AND RND(6)=1 THEN PROCtirabomba(DES%+2+3*RND(7)-3,8)
ENDPROC
#
DEF PROCbomba(K%)
VDU 31,BBX%(K%),BBY%(K%),32
BBY%(K%)=BBY%(K%)+1
IF BBY%(K%)>15 THEN BBY%(K%)=-1:ENDPROC
IF BBY%(K%)=15 AND BBX%(K%)=PX% THEN BBY%(K%)=-1:PROCchoque:ENDPROC
IF BBX%(K%)<0 OR BBX%(K%)>29 THEN BBY%(K%)=-1:ENDPROC
VDU 31,BBX%(K%),BBY%(K%),166
ENDPROC
#
REM El jugador recibe un golpe (salvo con el escudo puesto)
DEF PROCchoque
LOCAL I%
IF ESC%>0 THEN ENDPROC
SOUND 1,-15,20,20
FOR I%=1 TO 6:VDU 31,PX%,15,167:WAIT 8:VDU 31,PX%,15,162:WAIT 8:NEXT
VI%=VI%-1:PROCmarcador
FOR I%=0 TO 2:IF BBY%(I%)>=0 THEN VDU 31,BBX%(I%),BBY%(I%),32:BBY%(I%)=-1
NEXT
ESC%=25
ENDPROC
#
DEF PROCfin
PROCmsg("FIN DEL JUEGO")
IF PU%>REC% THEN REC%=PU%:PROCgrabarec:PROCmarcador:PROCmsg("¡Nuevo récord!")
WAIT 150
ENDPROC
#
DEF FNotra
LOCAL K$
PROCmsg("¿Otra partida? (S/N)")
REPEAT K$=GET$:UNTIL INSTR("SsNn",K$)
=(K$="S" OR K$="s")
#
DEF FNleerec
LOCAL F%,R%
F%=OPENIN "CHEFENIX.REC"
IF F%=0 THEN =0
INPUT#F%,R%:CLOSE#F%
=R%
#
DEF PROCgrabarec
LOCAL F%
F%=OPENOUT "CHEFENIX.REC":PRINT#F%,REC%:CLOSE#F%
ENDPROC
#
{error} IF ERR=17 THEN CHAIN "MENU"
MODE 0:VDU 23,1,1;0;0;0;:REPORT:PRINT " (línea ";ERL;")":END
#
DEF FNmax(A%,B%)
IF A%>B% THEN =A%
=B%
