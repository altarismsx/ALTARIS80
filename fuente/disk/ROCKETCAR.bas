# ROCKET CAR - pilotea el auto cohete por la caverna
# Version para ALTARIS 80 del juego de Altaris Software.
REM ROCKET CAR - (C) 2026 Altaris Software
ON ERROR GOTO {error}
MODE 1:VDU 23,1,0;0;0;0;
DIM TE%(80),PS%(80),G% 10
PROCcaracteres
REC%=FNleerec
{inicio} PROCportada
{juego} PA%=1:VI%=3:PU%=0:FUERA%=FALSE:TD%=TIME+6000
REPEAT
PROCpantalla(PA%)
PROCvuelo
IF EXITO% THEN PU%=PU%+100+NA% DIV 2:PA%=PA%+1:SOUND 1,-15,150,10
IF NOT EXITO% AND NOT FUERA% THEN VI%=VI%-1
UNTIL VI%=0 OR PA%>20 OR FUERA%
IF DEMO% THEN GOTO {inicio}
IF PA%>20 THEN PROCmsg("¡LLEGASTE A LA SALIDA!"):WAIT 300
PROCfin
IF FNotra THEN GOTO {juego}
CHAIN "MENU"
#
DEF PROCcaracteres
VDU 23,162,0,15,48,64,255,255,96,96
VDU 23,163,0,192,48,8,255,254,12,12
VDU 23,164,66,66,165,24,0,0,0,0
VDU 23,165,129,66,36,0,0,36,66,129
ENDPROC
#
DEF PROCportada
LOCAL K%,I%
VDU 26:CLS:CLG
FOR I%=0 TO 79:RECTANGLE FILL I%*4,0,3,4+RND(6):RECTANGLE FILL I%*4,118-RND(4),3,20:NEXT
PROCgrande("ROCKET",106,113,3)
PROCgrande("CAR",133,87,3)
PRINT TAB(11,8);"Altaris Software ";CHR$169;" 2026"
PRINT TAB(3,9);"Flecha arriba o Espacio: propulsor"
PRINT TAB(3,10);"Derecha/izquierda: acelerar/frenar"
PRINT TAB(3,11);"Llegá a la derecha sin chocar"
PRINT TAB(3,12);"R";CHR$233;"cord: ";REC%
PRINT TAB(3,13);"Pulse Espacio para empezar";
K%=INKEY(1000):DEMO%=(K%<>32)
ENDPROC
#
DEF PROCgrande(T$,X0%,Y0%,S%)
LOCAL I%,F%,B%
FOR I%=1 TO LEN(T$)
?G%=ASC(MID$(T$,I%,1)):A%=10:X%=G% MOD 256:Y%=G% DIV 256:CALL &FFF1
FOR F%=0 TO 7
B%=G%?(F%+1)
IF B% THEN PROCfila(B%,X0%+(I%-1)*6*S%,Y0%-F%*S%,S%)
NEXT
NEXT
ENDPROC
#
DEF PROCfila(B%,X1%,Y1%,S%)
LOCAL C%
FOR C%=0 TO 7
IF B% AND 2^(7-C%) THEN RECTANGLE FILL X1%+C%*S%,Y1%,S%-1,S%-1
NEXT
ENDPROC
#
REM Arma la caverna de la pantalla N%: techo TE%() y piso PS%()
DEF PROCpantalla(N%)
LOCAL I%,C%,F%,H%,M%,D%
VDU 26:CLS:CLG
D%=RND(-N%*7)
H%=74-N%*2:IF H%<34 THEN H%=34
M%=60
FOR I%=0 TO 80
IF I% MOD 4=0 THEN M%=M%+RND(17)-9+(M%>80)*4-(M%<40)*4
IF M%-H% DIV 2<6 THEN M%=6+H% DIV 2
IF M%+H% DIV 2>114 THEN M%=114-H% DIV 2
C%=M%+H% DIV 2+RND(5)-3:F%=M%-H% DIV 2+RND(5)-3
IF I%>8 AND I%<76 AND RND(40-N%)=1 THEN C%=C%-H% DIV 3
IF I%>8 AND I%<76 AND RND(40-N%)=1 THEN F%=F%+H% DIV 3
IF C%>117 THEN C%=117
TE%(I%)=C%:PS%(I%)=F%
NEXT
D%=RND(-TIME)
GCOL 0,1
FOR I%=0 TO 79
RECTANGLE FILL I%*4,TE%(I%),3,127-TE%(I%)
RECTANGLE FILL I%*4,0,3,PS%(I%)
NEXT
NA%=300:CX%=4*16:CY%=((TE%(0)+PS%(0)) DIV 2-4)*16:VX%=28:VY%=0:FL%=FALSE:FD%=FALSE
PROChud
ENDPROC
#
DEF PROChud
COLOUR 129:COLOUR 0
PRINT TAB(0,0);"PANTALLA ";PA%;"/20  VIDAS ";VI%;"  PUNTOS ";PU%;"  ";
IF DEMO% THEN PRINT TAB(36,0);"DEMO";
COLOUR 128:COLOUR 1
PROCnafta
ENDPROC
#
DEF PROCnafta
COLOUR 129:COLOUR 0
PRINT TAB(0,15);"NAFTA ";LEFT$(STRING$(NA% DIV 15,CHR$128)+STRING$(20," "),20);" ";
COLOUR 128:COLOUR 1
ENDPROC
#
DEF PROCmsg(T$)
COLOUR 129:COLOUR 0
PRINT TAB(20-LEN(T$) DIV 2,7);T$;
COLOUR 128:COLOUR 1
ENDPROC
#
REM Dibuja el auto (O exclusivo) en CX%,CY%; PROCborra lo saca
DEF PROCauto
FD%=FL%:AX%=CX% DIV 16:AY%=CY% DIV 16
PROCborra
ENDPROC
#
DEF PROCborra
VDU 5:GCOL 3,1:MOVE AX%,AY%+7:PRINT CHR$162;CHR$163;
IF FD% THEN MOVE AX%+4,AY%-1:PRINT CHR$164;
VDU 4
ENDPROC
#
DEF PROCvuelo
LOCAL T%,Q%,I%,J%,K%,NX%,NY%
EXITO%=FALSE:CHOQUE%=FALSE:Q%=0
PROCauto
REPEAT
T%=TIME
IF DEMO% THEN PROCpiloto ELSE PROCteclas
VY%=VY%-3:IF FL% THEN VY%=VY%+7:NA%=NA%-1
IF VY%>40 THEN VY%=40 ELSE IF VY%<-40 THEN VY%=-40
CX%=CX%+VX%:CY%=CY%+VY%:NX%=CX% DIV 16:NY%=CY% DIV 16
I%=NX% DIV 4:J%=(NX%+15) DIV 4:K%=(NX%+8) DIV 4:IF J%>80 THEN J%=80
IF NX%>=304 THEN EXITO%=TRUE ELSE IF NY%<0 OR NY%>119 OR NY%+7>=TE%(I%) OR NY%<=PS%(I%) OR NY%+7>=TE%(J%) OR NY%<=PS%(J%) OR NY%+7>=TE%(K%) OR NY%<=PS%(K%) THEN CHOQUE%=TRUE
VDU 5:GCOL 3,1:MOVE AX%,AY%+7:PRINT CHR$162;CHR$163;:IF FD% THEN MOVE AX%+4,AY%-1:PRINT CHR$164;
AX%=NX%:AY%=NY%:FD%=FL%
IF NOT EXITO% THEN MOVE AX%,AY%+7:PRINT CHR$162;CHR$163;:IF FD% THEN MOVE AX%+4,AY%-1:PRINT CHR$164;
VDU 4
Q%=Q%+1:IF Q% MOD 10=0 THEN PROCnafta
IF DEMO% THEN IF INKEY(0)>=0 OR TIME>TD% THEN FUERA%=TRUE
REPEAT UNTIL TIME>=T%+4
UNTIL EXITO% OR CHOQUE% OR FUERA%
IF CHOQUE% THEN PROCexplota
ENDPROC
#
DEF PROCteclas
FL%=(INKEY(-58) OR INKEY(-99)) AND NA%>0
IF INKEY(-122) AND VX%<48 THEN VX%=VX%+2
IF INKEY(-26) AND VX%>12 THEN VX%=VX%-2
ENDPROC
#
REM Piloto automatico para el modo demostracion
DEF PROCpiloto
LOCAL I%,M%
I%=(CX% DIV 16+20) DIV 4:IF I%>80 THEN I%=80
M%=(TE%(I%)+PS%(I%)) DIV 2-4
FL%=(CY% DIV 16<M%-VY% DIV 4) AND NA%>0
VX%=20
ENDPROC
#
DEF PROCchoques
LOCAL X%,Y%,I%,J%
X%=CX% DIV 16:Y%=CY% DIV 16
IF Y%<0 OR Y%+7>127 THEN CHOQUE%=TRUE:ENDPROC
FOR I%=X% DIV 4 TO (X%+15) DIV 4
J%=I%:IF J%>80 THEN J%=80
IF Y%+7>=TE%(J%) OR Y%<=PS%(J%) THEN CHOQUE%=TRUE
NEXT
ENDPROC
#
DEF PROCexplota
LOCAL I%,X%,Y%
X%=CX% DIV 16+4:Y%=CY% DIV 16+3
SOUND 1,-15,20,20
VDU 5:GCOL 3,1
FOR I%=1 TO 8
MOVE X%,Y%+7:PRINT CHR$165;:WAIT 6
MOVE X%,Y%+7:PRINT CHR$165;:WAIT 2
NEXT
VDU 4
PROCmsg("¡CHOCASTE!"):WAIT 120
ENDPROC
#
DEF PROCfin
PROCmsg("  FIN DEL JUEGO  ")
IF PU%>REC% THEN REC%=PU%:PROCgrabarec:WAIT 80:PROCmsg(" ¡NUEVO RÉCORD! ")
WAIT 150
ENDPROC
#
DEF FNotra
LOCAL K$
PROCmsg("¿Otra partida? (S/N)")
REPEAT K$=GET$:UNTIL INSTR("SsNn",K$)
=(K$="S" OR K$="s")
#
DEF FNleerec
LOCAL F%,R%
F%=OPENIN "ROCKETCAR.REC"
IF F%=0 THEN =0
INPUT#F%,R%:CLOSE#F%
=R%
#
DEF PROCgrabarec
LOCAL F%
F%=OPENOUT "ROCKETCAR.REC":PRINT#F%,REC%:CLOSE#F%
ENDPROC
#
{error} IF ERR=17 THEN CHAIN "MENU"
MODE 0:VDU 23,1,1;0;0;0;:REPORT:PRINT " (línea ";ERL;")":END
