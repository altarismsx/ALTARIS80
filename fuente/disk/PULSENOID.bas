# PULSENOID - rompe ladrillos con la nave OVNI
# Version para ALTARIS 80 del juego de Altaris Software.
REM PULSENOID - (C) 2026 Altaris Software
ON ERROR GOTO {error}
MODE 1:VDU 23,1,0;0;0;0;
DIM BR%(11,5),G% 10
REC%=FNleerec
{inicio} PROCportada
{juego} VI%=3:PU%=0:NI%=1:FUERA%=FALSE:TD%=TIME+6000
REPEAT
PROCarmar(NI%)
REPEAT
PROCjugar
UNTIL VI%=0 OR QU%=0 OR FUERA%
IF QU%=0 AND NOT FUERA% THEN PROCsector:NI%=NI%+1
UNTIL VI%=0 OR FUERA%
IF DEMO% THEN GOTO {inicio}
PROCfin
IF FNotra THEN GOTO {juego}
CHAIN "MENU"
#
DEF PROCportada
LOCAL I%
CLS:CLG
FOR I%=1 TO 40:PLOT 69,RND(319),RND(127):NEXT
PROCgrande("PULSENOID",16,110,3)
PRINT TAB(9,7);"Altaris Software ";CHR$169;" 2026"
PRINT TAB(5,9);"Flechas o Z/X: mover la nave"
PRINT TAB(5,10);"Espacio: lanzar la bola"
PRINT TAB(5,11);"Volver: salir"
PRINT TAB(5,13);"R";CHR$233;"cord: ";REC%
PRINT TAB(5,15);"Pulse Espacio para empezar";
K%=INKEY(1000):DEMO%=(K%<>32)
ENDPROC
#
REM Texto grande: cada punto del caracter es un cuadrado de S% puntos
DEF PROCgrande(T$,X0%,Y0%,S%)
LOCAL I%,F%,B%
FOR I%=1 TO LEN(T$)
?G%=ASC(MID$(T$,I%,1)):A%=10:X%=G% MOD 256:Y%=G% DIV 256:CALL &FFF1
FOR F%=0 TO 7
B%=G%?(F%+1)
IF B% THEN PROCfila(B%,X0%+(I%-1)*6*S%,Y0%-F%*S%,S%)
NEXT
NEXT
ENDPROC
#
DEF PROCfila(B%,X1%,Y1%,S%)
LOCAL C%
FOR C%=0 TO 7
IF B% AND 2^(7-C%) THEN RECTANGLE FILL X1%+C%*S%,Y1%,S%-1,S%-1
NEXT
ENDPROC
#
DEF PROCarmar(N%)
LOCAL C%,R%,L%,T$,V%
CLS:CLG
GCOL 0,1
RECTANGLE FILL 0,0,3,127:RECTANGLE FILL 236,0,3,127:RECTANGLE FILL 0,124,239,3
FOR C%=1 TO 25:PLOT 69,8+RND(222),18+RND(50):NEXT
L%=(N%-1) MOD 5
RESTORE {niveles}
IF L%>0 THEN FOR R%=1 TO L%*6:READ T$:NEXT
QU%=0
FOR R%=0 TO 5
READ T$
FOR C%=0 TO 11
V%=VAL(MID$(T$,C%+1,1)):BR%(C%,R%)=V%
IF V%>0 THEN QU%=QU%+1:PROCladrillo(C%,R%)
NEXT
NEXT
Q0%=QU%:SP%=24+3*((N%-1) DIV 5)+(N%-1) MOD 5
PRINT TAB(31,0);"PULSENOID"
PRINT TAB(31,2);"PUNTOS"
PRINT TAB(31,5);"VIDAS"
PRINT TAB(31,8);"SECTOR"
PRINT TAB(31,11);"R";CHR$201;"CORD"
IF DEMO% THEN PRINT TAB(31,14);"DEMO"
PROCmarcador
ENDPROC
#
DEF PROCladrillo(C%,R%)
LOCAL X%,Y%
X%=6+19*C%:Y%=114-8*R%
GCOL 0,1
IF BR%(C%,R%)=1 THEN RECTANGLE FILL X%,Y%,16,5 ELSE RECTANGLE X%,Y%,16,5:RECTANGLE X%+2,Y%+2,12,1
ENDPROC
#
DEF PROCmarcador
PRINT TAB(31,3);PU%;"   "
PRINT TAB(31,6);VI%;"  "
PRINT TAB(31,9);(NI%-1) DIV 3+1;"-";(NI%-1) MOD 3+1;"  "
PRINT TAB(31,12);REC%;"   "
ENDPROC
#
DEF PROCmsg(T$)
PRINT TAB(1,9);SPC(28);
IF T$<>"" THEN PRINT TAB(15-LEN(T$) DIV 2,9);T$;
ENDPROC
#
REM La nave OVNI (se dibuja y se borra con O exclusivo)
DEF PROCnave
GCOL 3,1
RECTANGLE FILL PX%+8,12,7,0:RECTANGLE FILL PX%+5,11,13,0
RECTANGLE FILL PX%,10,23,0:RECTANGLE FILL PX%+3,9,17,0
RECTANGLE FILL PX%+7,8,9,0
ENDPROC
#
REM La bola: 5x5 puntos redondeada, centrada en X%,Y% (tres franjas que
REM no se pisan, para que el O exclusivo la borre bien)
DEF PROCbola
GCOL 3,1
RECTANGLE FILL X%-1,Y%+2,2,0
RECTANGLE FILL X%-2,Y%-1,4,2
RECTANGLE FILL X%-1,Y%-2,2,0
ENDPROC
#
DEF PROCmover
LOCAL N%
IF DEMO% THEN N%=FNauto ELSE N%=FNteclas
IF N%<4 THEN N%=4
IF N%>212 THEN N%=212
IF N%<>PX% THEN PROCnave:PX%=N%:PROCnave
ENDPROC
#
DEF FNteclas
LOCAL N%
N%=PX%
IF INKEY(-26) OR INKEY(-98) THEN N%=N%-4
IF INKEY(-122) OR INKEY(-67) THEN N%=N%+4
=N%
#
REM Modo demostracion: la nave sigue a la bola
DEF FNauto
LOCAL T%
T%=X%-11+RND(7)-4
IF T%<PX%-3 THEN =PX%-4
IF T%>PX%+3 THEN =PX%+4
=PX%
#
DEF PROCjugar
LOCAL T%,NX%,NY%,PY%,C%,R%,K%,BV%
PX%=108:PROCnave
X%=PX%+11:Y%=15:PROCbola
PROCmsg("Espacio: lanzar")
REPEAT
T%=TIME:PROCmover
IF X%<>PX%+11 THEN PROCbola:X%=PX%+11:PROCbola
REPEAT UNTIL TIME>=T%+2
UNTIL INKEY(-99) OR DEMO%
PROCmsg("")
BOLX%=X%*16:BOLY%=Y%*16:DX%=SP% DIV 2:DY%=SP%
IF RND(2)=1 THEN DX%=-DX%
REM La bola se borra y se vuelve a dibujar recien al final, una cosa pegada
REM a la otra: asi se ve casi todo el tiempo (BV% = todavia dibujada)
REPEAT
T%=TIME:BV%=TRUE
PROCmover
BOLX%=BOLX%+DX%:BOLY%=BOLY%+DY%
NX%=BOLX% DIV 16:NY%=BOLY% DIV 16
IF NX%<6 THEN NX%=6:BOLX%=96:DX%=-DX%
IF NX%>233 THEN NX%=233:BOLX%=233*16:DX%=-DX%
IF NY%>121 THEN NY%=121:BOLY%=121*16:DY%=-DY%
IF NY%<2 THEN NY%=2
IF DY%<0 AND NY%<=15 AND NY%>=10 AND NX%+2>=PX% AND NX%-2<=PX%+23 THEN PROCrebote:NY%=15:BOLY%=240
REM con los ladrillos choca el borde de la bola que va adelante
PY%=NY%+2*SGN(DY%)
IF PY%>=82 AND PY%<=119 THEN
C%=(NX%-6) DIV 19:R%=(119-PY%) DIV 8
IF C%>=0 AND C%<=11 AND R%>=0 AND R%<=5 THEN IF BR%(C%,R%)>0 AND (NX%-6) MOD 19<=16 AND (119-PY%) MOD 8<=5 THEN PROCbola:BV%=FALSE:PROCgolpe(C%,R%):DY%=-DY%
ENDIF
IF BV% THEN PROCbola
X%=NX%:Y%=NY%:PROCbola
REPEAT UNTIL TIME>=T%+2
IF DEMO% THEN IF INKEY(0)>=0 OR TIME>TD% THEN FUERA%=TRUE
UNTIL Y%<3 OR QU%=0 OR FUERA%
PROCbola
IF QU%>0 AND NOT FUERA% THEN PROCexplota:VI%=VI%-1:PROCmarcador
PROCnave
ENDPROC
#
DEF PROCrebote
DY%=-DY%
DX%=(NX%-PX%-11)*SP% DIV 9
IF DX%=0 THEN DX%=2
IF ABS(DX%)>SP%*5 DIV 4 THEN DX%=SGN(DX%)*SP%*5 DIV 4
ENDPROC
#
DEF PROCgolpe(C%,R%)
LOCAL X%,Y%
X%=6+19*C%:Y%=114-8*R%
IF BR%(C%,R%)=2 THEN BR%(C%,R%)=1:PROCladrillo(C%,R%):PU%=PU%+5:PROCmarcador:ENDPROC
BR%(C%,R%)=0:QU%=QU%-1:PU%=PU%+10
GCOL 3,1:RECTANGLE FILL X%-2,Y%-1,20,7
GCOL 0,0:RECTANGLE FILL X%-2,Y%-1,20,7
IF QU%*2<Q0% AND ABS(DY%)<SP%*5 DIV 4 THEN DY%=DY%*5 DIV 4:DX%=DX%*5 DIV 4
PROCmarcador
ENDPROC
#
DEF PROCexplota
LOCAL I%,J%,A%,X0%,Y0%
X0%=PX%+11:Y0%=10
GCOL 3,1
FOR I%=1 TO 6
FOR J%=0 TO 7:A%=J%*45:MOVE X0%,Y0%:DRAW X0%+I%*3*COS(RAD(A%)),Y0%+I%*3*SIN(RAD(A%)):NEXT
WAIT 4
FOR J%=0 TO 7:A%=J%*45:MOVE X0%,Y0%:DRAW X0%+I%*3*COS(RAD(A%)),Y0%+I%*3*SIN(RAD(A%)):NEXT
NEXT
SOUND 1,-15,50,10
ENDPROC
#
DEF PROCsector
PROCmsg("SECTOR "+STR$((NI%-1) DIV 3+1)+"-"+STR$((NI%-1) MOD 3+1)+" TERMINADO")
SOUND 1,-15,100,20
WAIT 200
ENDPROC
#
DEF PROCfin
PROCmsg("FIN DEL JUEGO")
IF PU%>REC% THEN REC%=PU%:PROCgrabarec:PROCmarcador:PRINT TAB(8,11);"¡Nuevo récord!";
WAIT 150
ENDPROC
#
DEF FNotra
LOCAL K$
PROCmsg("¿Otra partida? (S/N)")
REPEAT K$=GET$:UNTIL INSTR("SsNn",K$)
=(K$="S" OR K$="s")
#
DEF FNleerec
LOCAL F%,R%
F%=OPENIN "PULSENOID.REC"
IF F%=0 THEN =0
INPUT#F%,R%:CLOSE#F%
=R%
#
DEF PROCgrabarec
LOCAL F%
F%=OPENOUT "PULSENOID.REC":PRINT#F%,REC%:CLOSE#F%
ENDPROC
#
{error} IF ERR=17 THEN CHAIN "MENU"
MODE 0:VDU 23,1,1;0;0;0;:REPORT:PRINT " (línea ";ERL;")":END
#
REM Niveles: 0 vacio, 1 ladrillo, 2 ladrillo duro (dos golpes)
{niveles} DATA "000000000000","111111111111","111111111111","111111111111","111111111111","000000000000"
DATA "000001100000","000011110000","000111111000","001111111100","011111111110","111111111111"
DATA "212121212121","121212121212","212121212121","121212121212","000000000000","000000000000"
DATA "222222222222","100000000001","101111111101","101000000101","101111111101","100000000001"
DATA "110011001100","110011001100","001100110011","001100110011","222222222222","111111111111"
